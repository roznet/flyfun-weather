<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FlyFunWeatherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="FlyFun Weather"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <service
            android:name=".service.FlightTrackingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- FCM push (briefing refresh, flight-day brief, live alerts) -->
        <service
            android:name=".service.FlyFunMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel for a server message that names none (the server always names one) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="flyfun_briefing_updates" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Push notification tap: the server's FCM click_action (notify/push.py). A
                 launcher intent would only bring a running app to the front, without the
                 flight in its extras. -->
            <intent-filter>
                <action android:name="aero.flyfun.weather.OPEN_NOTIFICATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Custom scheme for OAuth & Autorouter callbacks -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flyfunweather" />
            </intent-filter>

            <!-- Android App Links for weather.flyfun.aero -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="weather.flyfun.aero" android:path="/briefing.html" />
                <data android:scheme="https" android:host="weather.flyfun.aero" android:path="/maps.html" />
                <data android:scheme="https" android:host="weather.flyfun.aero" android:path="/trip.html" />
                <data android:scheme="https" android:host="weather.flyfun.aero" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="weather.flyfun.aero" android:pathPrefix="/t/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
