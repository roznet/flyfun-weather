# Xcode
xcuserdata/
*.xcuserstate
DerivedData/
.build/
*.xcscmblueprint
eval_data
test-results/

# Eval labelling workbench (#254): the pulled corpus lives under eval_data/
# (already ignored). Pack payloads are reproducible from prod; only each pack's
# corpus_meta.json + label.json are committed, via `git add -f` (see
# scripts/pull_eval_corpus.py output). The candidate manifest is a scratch file.
eval_candidates.json

# ECMWF sample GRIB files (large binary, not for git)
tests/data/ecmwf_samples/
tests/data/hrrr_samples/

# Codex, primary is .claude, codex generates these from claude setup
AGENTS.md
.agents
.codex

# Local scratch memos — untracked by design
scratch/

# Real compute-node inventory: ssh targets and paths are deployment-private.
# deploy/compute-nodes.example.json is tracked and documents the shape.
deploy/compute-nodes.json

# Real MySQL config/counter baseline: container names, host paths and tuning
# values are deployment-specific. Used by the check-health skill (§10) to spot
# config drift. deploy/mysql-baseline.example.json is tracked and documents the
# shape. Not a deploy artifact — the authoritative config lives in the private
# infra repo that owns the MySQL compose stack.
deploy/mysql-baseline.json
