weather.flyfun.aero {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        # Framing is governed by CSP frame-ancestors below (talks.flyfun.aero embeds
        # live briefing views); X-Frame-Options SAMEORIGIN would contradict it.
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tiles.stadiamaps.com; connect-src 'self' https://*.flyfun.aero; font-src 'self'; frame-ancestors 'self' https://talks.flyfun.aero; base-uri 'self'; form-action 'self' https://accounts.google.com"
        -Server
    }

    # Apple Universal Links — associate app with this domain.
    # iOS fetches and caches this file per-install, so a path must be
    # deployed BEFORE the app build that handles it ships — otherwise the
    # link keeps opening Safari until iOS next re-reads the file.
    handle /.well-known/apple-app-site-association {
        header Content-Type application/json
        respond `{"applinks":{"apps":[],"details":[{"appID":"M7QSSF3624.net.ro-z.flyfun-weather","paths":["/auth/callback","/briefing.html","/maps.html","/trip.html","/s/*","/t/*"]}]}}`
    }

    # Android App Links — associate aero.flyfun.weather with this domain.
    # Fingerprints: Google's Play App Signing certificate (what Play installs are
    # signed with), then our upload key (locally built release APKs). Android
    # verifies per-install, so deploy before a build that relies on a new path.
    handle /.well-known/assetlinks.json {
        header Content-Type application/json
        respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"aero.flyfun.weather","sha256_cert_fingerprints":["62:E1:FC:6E:F2:7F:3A:4D:2C:41:BD:31:A0:46:78:17:D1:82:A7:F1:D3:7D:5C:F0:20:8D:16:61:53:6E:51:BE","91:D5:8A:76:69:4C:99:5F:6A:48:A5:43:DD:9F:EE:3E:20:24:03:C2:B4:C2:85:41:B9:6F:10:FC:3B:09:67:CC"]}}]`
    }

    # OAuth 2.1 Authorization Server metadata (RFC 8414) — lets native/third-party
    # apps treat weather.flyfun.aero as the issuer and discover the OAuth endpoints.
    # Only the least-privilege "flights:read" scope is advertised here. The broad
    # "mcp" (full-access) scope is supported by the AS but advertised exclusively
    # via mcp.flyfun.aero's metadata, so third-party apps default to read access.
    handle /.well-known/oauth-authorization-server* {
        header Content-Type application/json
        respond `{
  "issuer": "https://weather.flyfun.aero",
  "authorization_endpoint": "https://weather.flyfun.aero/oauth/authorize",
  "token_endpoint": "https://weather.flyfun.aero/oauth/token",
  "registration_endpoint": "https://weather.flyfun.aero/oauth/register",
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "refresh_token"],
  "token_endpoint_auth_methods_supported": ["client_secret_post"],
  "code_challenge_methods_supported": ["S256"],
  "scopes_supported": ["flights:read"]
}`
    }

    # MCP server alias: weather.flyfun.aero/mcp serves the same MCP server as
    # mcp.flyfun.aero/weather (pilots guess this URL). The protected-resource
    # metadata advertises "mcp" for THIS resource only, so the AS metadata above
    # keeps its flights:read default for third-party apps.
    handle /.well-known/oauth-protected-resource/mcp {
        header Content-Type application/json
        respond `{"resource":"https://weather.flyfun.aero/mcp","authorization_servers":["https://weather.flyfun.aero"],"scopes_supported":["mcp"],"bearer_methods_supported":["header"],"resource_name":"FlyFun Weather Briefings"}`
    }
    handle /mcp/.well-known/oauth-protected-resource {
        header Content-Type application/json
        respond `{"resource":"https://weather.flyfun.aero/mcp","authorization_servers":["https://weather.flyfun.aero"],"scopes_supported":["mcp"],"bearer_methods_supported":["header"],"resource_name":"FlyFun Weather Briefings"}`
    }
    # Maintenance switch. While MAINTENANCE_ON exists every request (except the
    # .well-known association/OAuth files above) is answered by handle_errors
    # below with the status page — even if the app is up, e.g. mid-migration.
    # Caddy checks the file per request: no reload to switch. Flip it with
    # scripts/ops/maintenance.py on/off, never by hand.
    @maintenance {
        file {
            root /home/brice/www/weather-status
            try_files /MAINTENANCE_ON
        }
        not path /.well-known/*
    }
    handle @maintenance {
        error "maintenance" 503
    }

    handle /mcp* {
        reverse_proxy localhost:8021 {
            header_up X-Real-IP {remote_host}
            header_down WWW-Authenticate `resource_metadata="[^"]*"` `resource_metadata="https://weather.flyfun.aero/.well-known/oauth-protected-resource/mcp", scope="mcp"`
        }
    }

    # Don't expose client-side recon surface: the app's StaticFiles mount serves
    # the whole web/ tree, including raw TypeScript sources (/ts/*) and esbuild
    # sourcemaps (*.js.map). Block them at the edge — the bundled /dist/*.js is
    # all the browser needs.
    @client_sources path /ts/* *.map
    respond @client_sources 404

    # No endpoint takes uploads; the largest legitimate JSON bodies (flight
    # create, PIREP batch, bulk ids) are a few KB. Cap well above that so an
    # anonymous oversized POST is refused at the edge (413) instead of being
    # parsed and validated by the single uvicorn worker.
    request_body {
        max_size 1MB
    }

    reverse_proxy localhost:8020 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Status page when the app can't answer: the backend is down (Caddy's own
    # 502 on a refused dial, 504 on a timeout) or the maintenance switch above
    # is on (503). An app that answers with its own 5xx is passed through
    # untouched — this only covers Caddy-generated errors.
    #
    # API clients get status.json, browsers status.html, both written by
    # scripts/ops/maintenance.py into ~/www/weather-status. The JSON carries a
    # FastAPI-style "detail" sentence, so app builds that predate the
    # maintenance banner still show the message instead of an HTML dump.
    # file_server keeps the error's status code (502/503/504). The status
    # directory must exist before this is reloaded: `maintenance.py off`
    # installs it. Checked on Caddy 2.11.7 (the droplet's Docker image) and
    # 2.6.2, hence the expression matcher rather than `handle_errors 502 503 504`.
    handle_errors {
        @unavailable expression `{err.status_code} in [502, 503, 504]`
        handle @unavailable {
            root * /home/brice/www/weather-status
            header Cache-Control "no-store"
            header Retry-After 120
            # These three rewrites don't stack: the Caddyfile makes rewrites in
            # one block mutually exclusive (first match wins, matched ones
            # before `*`), so API paths get JSON. Checked on 2.11.7 and 2.6.2.
            @api_path path /api/* /mcp* /oauth/* /auth/* /health
            rewrite @api_path /status.json
            @wants_json header Accept *application/json*
            rewrite @wants_json /status.json
            rewrite * /status.html
            file_server
        }
        handle {
            respond "{err.status_code} {err.status_text}" {err.status_code}
        }
    }
}
