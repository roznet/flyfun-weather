# WeatherBrief secrets: copy to .env.secrets (gitignored) and fill in.
#
# Only values that would hurt if they were public live here; plain configuration
# is in .env (see .env.sample, which also documents what each setting does).
# weatherbrief.envfiles.load_env() and both docker compose services load .env
# first, then this file; variables already in the environment win over both.
# In the owner's setup this file is sops-encrypted in the config repo and
# decrypted by syncfiles on the host that uses it (mode 600): don't hand-edit it there.

# Autorouter account (flight routing)
AUTOROUTER_USERNAME=
AUTOROUTER_PASSWORD=

# Google sign-in (GOOGLE_CLIENT_ID is in .env)
GOOGLE_CLIENT_SECRET=

# Session signing. Rotating it logs every user out.
JWT_SECRET=
# Fernet key encrypting stored user credentials in the DB (prod only; derived
# from JWT_SECRET in dev). Changing it needs a re-encryption migration first.
CREDENTIAL_ENCRYPTION_KEY=

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGCHAIN_API_KEY=

# Open-Meteo customer key (optional: without it the free tier is used)
#OPENMETEO_API_KEY=

# Stripe donations: test-mode keys for local dev, live keys in prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EUMETSAT Data Store OAuth credentials (user.eumetsat.int -> API key),
# needed only for the eumetsat_* observed sources
#EUMETSAT_CONSUMER_KEY=
#EUMETSAT_CONSUMER_SECRET=
