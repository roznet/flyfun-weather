      "group": "along_route",
      "uses_altitude": false,
      "value": "cape_surface_jkg",
      "aggregation": "average",
      "scale": "cape_jkg",
      "width": { "thin_at": 0, "thick_at": 2000 },
      "format": { "kind": "number", "decimals": 0, "suffix": " J/kg" },
      "legend": [
