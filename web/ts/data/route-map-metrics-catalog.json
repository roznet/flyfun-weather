      "scale": "cloud_cover_pct",
      "width": { "thin_at": 0, "thick_at": 100 },
      "format": { "kind": "number", "decimals": 0, "suffix": "%" },
      "legend": [
        { "value": 0, "label": "Clear", "i18n_key": "map.clear" },
        { "value": 25, "label": "25%" },
        { "value": 50, "label": "50%" },
        { "value": 75, "label": "75%" },
        { "value": 100, "label": "Overcast", "i18n_key": "map.overcast" }
      ]
    },
    {
      "key": "cloud-cover-low",
      "label": "Cloud Cover (Low)",
      "i18n_key": "map.cloud-cover-low",
      "unit": "%",
      "group": "along_route",
      "uses_altitude": false,
      "value": "cloud_cover_low_pct",
      "aggregation": "average",
      "scale": "cloud_cover_pct",
      "width": { "thin_at": 0, "thick_at": 100 },
      "format": { "kind": "number", "decimals": 0, "suffix": "%" },
      "legend": [
        { "value": 0, "label": "Clear", "i18n_key": "map.clear" },
        { "value": 25, "label": "25%" },
