      "width": { "thin_at": 5000, "thick_at": 0 },
      "format": { "kind": "number", "decimals": 0, "suffix": " ft" },
      "legend": [
        { "value": 300, "label": "LIFR <500" },
        { "value": 700, "label": "IFR <1000" },
        { "value": 2000, "label": "MVFR <3000" },
        { "value": 5000, "label": "VFR 3000+" }
