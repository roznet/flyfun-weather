# WeatherBrief Web Server Configuration

# environment run as prod or development
ENVIRONMENT=development

AUTOROUTER_USERNAME=
AUTOROUTER_PASSWORD=

WORKING_DIR=/path/to/working/directory
AIRPORTS_DB=${WORKING_DIR}/airports.db

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

CREDENTIAL_ENCRYPTION_KEY=

# Keys
OPENAI_API_KEY=

ANTHROPIC_API_KEY=

# Optional OPENAI_API_KEY, if not set, it will use the free tier with limited capabilities and rate limits.
#OPENMETEO_API_KEY=


LANGCHAIN_API_KEY=
# Tracing exports full LLM prompts (user routes, dates, digest content) to
# LangSmith — keep it off unless you explicitly want that.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=WeatherBrief
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Donations (Stripe) — web-only voluntary donations (issue #186)
# Test-mode keys for local dev; live keys in prod secrets. The donation webhook
# is the source of truth — register the endpoint (POST /api/donations/webhook)
# in the Stripe Dashboard and pin its API version there (see designs).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public base URL used to build absolute Stripe success/cancel redirect URLs
# (also used for email links). Defaults to https://weather.flyfun.aero in prod.
#WEATHERBRIEF_BASE_URL=http://localhost:8000

# Retention — disk cleanup for old briefing packs
# T1: strip heavy artifacts (skewt, gramet, cross_section) N days after departure
#RETENTION_T1_DAYS=30
# T2: delete all pack data N days after departure (active users)
#RETENTION_T2_ACTIVE_DAYS=180
# T2: delete all pack data N days after departure (inactive users)
#RETENTION_T2_INACTIVE_DAYS=90
# User considered inactive after N days without login or briefing
#RETENTION_INACTIVE_DAYS=30
# Set to 1 to log what would be deleted without actually deleting
#RETENTION_DRY_RUN=0
# Set to 1 to disable the retention loop entirely
#DISABLE_RETENTION=0

# App Store Connect API (scripts/asc.py — iOS release staging)
# Create the key at App Store Connect -> Users and Access -> Integrations.
# It needs the App Manager role; a Developer-role key can read but cannot
# create versions or edit metadata. Apple lets you download the .p8 once.
# Keep the .p8 OUTSIDE this repo — the conventional location below is what
# xcodebuild and altool search by default.
ASC_KEY_ID=
ASC_ISSUER_ID=
#ASC_KEY_P8_PATH=~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# Optional: skips a bundle-id lookup on every call.
#ASC_APP_ID=

# ECMWF Commercial GRIB Data (ECPDS delivery)
# Directory where ECMWF files are delivered (mounted as Docker volume in prod)
#ECMWF_GRIB_DIR=/data/ecmwf
# Host path for Docker volume mount (only used in docker-compose)
#HOST_ECMWF_GRIB_DIR=/path/to/ecmwf/data
